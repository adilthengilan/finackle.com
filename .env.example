# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Secret API key from Resend (https://resend.com/api-keys)
RESEND_API_KEY=""

# ADMIN_EMAIL: Recipient email where website enquiries are delivered
ADMIN_EMAIL="info@finackle.com"

# FROM_EMAIL: Sender address with verified domain in Resend
FROM_EMAIL="Finackle <website@finackle.com>"

# VITE_WHATSAPP_NUMBER: UAE contact number for WhatsApp click-to-chat
VITE_WHATSAPP_NUMBER="971545022747"
